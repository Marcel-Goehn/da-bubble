        "type" : "object"
      },
      "ThreadPageDto" : {
        "properties" : {
          "nextCursor" : {
            "type" : [ "string", "null" ]
          },
          "parent" : {
            "$ref" : "#/components/schemas/MessageDto"
          },
          "replies" : {
            "items" : {
              "$ref" : "#/components/schemas/MessageDto"
            },
            "type" : "array"
          }
        },
        "required" : [ "nextCursor", "parent", "replies" ],
        "type" : "object"
      },
      "ThreadSummaryDto" : {
        "properties" : {
          "lastReplyAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "parentMessageId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "replyCount" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "lastReplyAt", "parentMessageId", "replyCount" ],
        "type" : "object"
      },
      "ToggleReactionRequest" : {
        "properties" : {
          "emoji" : {
            "type" : "string"
          }
        },
        "required" : [ "emoji" ],
        "type" : "object"
      },
      "UserDto" : {
        "properties" : {
          "avatar" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/PredefinedAvatar"
            }, {
              "type" : "null"
            } ]
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "avatar", "email", "id", "name" ],
        "type" : "object"
      }
    }
  },
  "info" : {
