{
  "components" : {
    "schemas" : {
      "AddMembersRequest" : {
        "properties" : {
          "userIds" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [ "userIds" ],
        "type" : "object"
      },
      "ConversationDto" : {
        "properties" : {
          "creatorId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "isDefault" : {
            "type" : "boolean"
          },
          "kind" : {
            "$ref" : "#/components/schemas/ConversationKind"
          },
          "lastActivityAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "members" : {
            "items" : {
              "$ref" : "#/components/schemas/MemberDto"
            },
            "type" : "array"
          },
          "name" : {
            "type" : [ "string", "null" ]
          },
          "partnerId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "creatorId", "description", "id", "isDefault", "kind", "lastActivityAt", "members", "name", "partnerId" ],
        "type" : "object"
      },
      "ConversationKind" : {
        "enum" : [ "CHANNEL", "DIRECT_MESSAGE" ],
        "type" : "string"
      },
      "ConversationRemovedEvent" : {
        "properties" : {
          "conversationId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "type" : {
            "enum" : [ "conversation.removed" ],
            "type" : "string"
          }
        },
        "required" : [ "conversationId", "type" ],
        "type" : "object"
      },
      "ConversationUpsertedEvent" : {
        "properties" : {
          "conversation" : {
            "$ref" : "#/components/schemas/ConversationDto"
          },
          "type" : {
            "enum" : [ "conversation.upserted" ],
            "type" : "string"
          }
        },
        "required" : [ "conversation", "type" ],
        "type" : "object"
      },
      "CreateChannelRequest" : {
        "properties" : {
          "addDefaultChannelMembers" : {
            "type" : "boolean"
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "memberIds" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "addDefaultChannelMembers", "memberIds", "name" ],
        "type" : "object"
      },
      "EditChannelRequest" : {
        "properties" : {
          "description" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : [ "string", "null" ]
          }
        },
        "type" : "object"
      },
      "EditMessageRequest" : {
        "properties" : {
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "text" ],
        "type" : "object"
      },
      "FieldErrorDto" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "field" ],
        "type" : "object"
      },
      "MemberDto" : {
        "properties" : {
          "isAdmin" : {
            "type" : "boolean"
          },
          "joinedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "userId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "isAdmin", "joinedAt", "userId" ],
        "type" : "object"
      },
      "MessageCreatedEvent" : {
        "properties" : {
          "message" : {
            "$ref" : "#/components/schemas/MessageDto"
          },
          "thread" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/ThreadSummaryDto"
            }, {
              "type" : "null"
            } ]
          },
          "type" : {
            "enum" : [ "message.created" ],
            "type" : "string"
          }
        },
        "required" : [ "message", "thread", "type" ],
        "type" : "object"
      },
      "MessageDto" : {
        "properties" : {
          "authorId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "conversationId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "deletedAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "editedAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "lastReplyAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "parentMessageId" : {
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "reactions" : {
            "items" : {
              "$ref" : "#/components/schemas/ReactionDto"
            },
            "type" : "array"
          },
          "replyCount" : {
            "format" : "int32",
            "type" : "integer"
          },
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "authorId", "conversationId", "createdAt", "deletedAt", "editedAt", "id", "lastReplyAt", "parentMessageId", "reactions", "replyCount", "text" ],
        "type" : "object"
      },
      "MessagePageDto" : {
        "properties" : {
          "messages" : {
            "items" : {
              "$ref" : "#/components/schemas/MessageDto"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "messages", "nextCursor" ],
        "type" : "object"
      },
      "MessageUpdatedEvent" : {
        "properties" : {
          "message" : {
            "$ref" : "#/components/schemas/MessageDto"
          },
          "type" : {
            "enum" : [ "message.updated" ],
            "type" : "string"
          }
        },
        "required" : [ "message", "type" ],
        "type" : "object"
      },
      "PredefinedAvatar" : {
        "enum" : [ "AVATAR_1", "AVATAR_2", "AVATAR_3", "AVATAR_4", "AVATAR_5", "AVATAR_6", "GUEST" ],
        "type" : "string"
      },
      "PresenceChangedEvent" : {
        "properties" : {
          "online" : {
            "type" : "boolean"
          },
          "type" : {
            "enum" : [ "presence.changed" ],
            "type" : "string"
          },
          "userId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "online", "type", "userId" ],
        "type" : "object"
      },
      "ProblemCode" : {
        "enum" : [ "BAD_REQUEST", "VALIDATION_FAILED", "MESSAGE_EMPTY", "REPLY_HAS_NO_THREAD", "EMOJI_INVALID", "CHANNEL_NAME_EMPTY", "CHANNEL_NAME_TOO_LONG", "UNAUTHENTICATED", "NOT_MESSAGE_AUTHOR", "NOT_CHANNEL_ADMIN", "NOT_CHANNEL_CREATOR", "CHANNEL_CREATOR_PROTECTED", "MANAGING_YOURSELF", "DEFAULT_CHANNEL_LOCKED", "NOT_FOUND", "CONFLICT", "MESSAGE_DELETED", "CHANNEL_NAME_TAKEN", "INTERNAL_ERROR" ],
        "type" : "string"
      },
      "ProblemDto" : {
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ProblemCode"
          },
          "detail" : {
            "type" : [ "string", "null" ]
          },
          "errors" : {
            "items" : {
              "$ref" : "#/components/schemas/FieldErrorDto"
            },
            "type" : "array"
          },
          "instance" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "detail", "errors", "instance", "status", "title", "type" ],
        "type" : "object"
      },
      "ReactionDto" : {
        "properties" : {
          "emoji" : {
            "type" : "string"
          },
          "userIds" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [ "emoji", "userIds" ],
        "type" : "object"
      },
      "RealtimeEvent" : {
        "discriminator" : {
          "mapping" : {
            "conversation.removed" : "#/components/schemas/ConversationRemovedEvent",
            "conversation.upserted" : "#/components/schemas/ConversationUpsertedEvent",
            "message.created" : "#/components/schemas/MessageCreatedEvent",
            "message.updated" : "#/components/schemas/MessageUpdatedEvent",
            "presence.changed" : "#/components/schemas/PresenceChangedEvent"
          },
          "propertyName" : "type"
        },
        "oneOf" : [ {
          "$ref" : "#/components/schemas/MessageCreatedEvent"
        }, {
          "$ref" : "#/components/schemas/MessageUpdatedEvent"
        }, {
          "$ref" : "#/components/schemas/ConversationUpsertedEvent"
        }, {
          "$ref" : "#/components/schemas/ConversationRemovedEvent"
        }, {
          "$ref" : "#/components/schemas/PresenceChangedEvent"
        } ]
      },
      "RestoreMemberRequest" : {
        "properties" : {
          "isAdmin" : {
            "type" : "boolean"
          },
          "joinedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
