{
  "components" : {
    "schemas" : {
      "ConversationDto" : {
        "properties" : {
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "isDefault" : {
            "type" : "boolean"
          },
          "kind" : {
            "$ref" : "#/components/schemas/ConversationKind"
          },
          "name" : {
            "type" : [ "string", "null" ]
          },
          "partnerId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "id", "isDefault", "kind", "name", "partnerId" ],
        "type" : "object"
      },
      "ConversationKind" : {
        "enum" : [ "CHANNEL", "DIRECT_MESSAGE" ],
        "type" : "string"
      },
      "FieldErrorDto" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "field" ],
        "type" : "object"
      },
      "MessageCreatedEvent" : {
        "properties" : {
          "message" : {
            "$ref" : "#/components/schemas/MessageDto"
          },
          "type" : {
            "enum" : [ "message.created" ],
            "type" : "string"
          }
        },
        "required" : [ "message", "type" ],
        "type" : "object"
      },
      "MessageDto" : {
        "properties" : {
          "authorId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "conversationId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "deletedAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "editedAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "parentMessageId" : {
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "authorId", "conversationId", "createdAt", "deletedAt", "editedAt", "id", "parentMessageId", "text" ],
        "type" : "object"
      },
      "MessagePageDto" : {
        "properties" : {
          "messages" : {
            "items" : {
              "$ref" : "#/components/schemas/MessageDto"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "messages", "nextCursor" ],
        "type" : "object"
      },
      "PredefinedAvatar" : {
        "enum" : [ "AVATAR_1", "AVATAR_2", "AVATAR_3", "AVATAR_4", "AVATAR_5", "AVATAR_6", "GUEST" ],
        "type" : "string"
      },
      "PresenceChangedEvent" : {
        "properties" : {
          "online" : {
            "type" : "boolean"
          },
          "type" : {
            "enum" : [ "presence.changed" ],
            "type" : "string"
          },
          "userId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "online", "type", "userId" ],
        "type" : "object"
      },
      "ProblemCode" : {
        "enum" : [ "BAD_REQUEST", "VALIDATION_FAILED", "MESSAGE_EMPTY", "UNAUTHENTICATED", "NOT_FOUND", "CONFLICT", "INTERNAL_ERROR" ],
        "type" : "string"
      },
      "ProblemDto" : {
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ProblemCode"
          },
          "detail" : {
            "type" : [ "string", "null" ]
          },
          "errors" : {
            "items" : {
              "$ref" : "#/components/schemas/FieldErrorDto"
            },
            "type" : "array"
          },
          "instance" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "detail", "errors", "instance", "status", "title", "type" ],
        "type" : "object"
      },
      "RealtimeEvent" : {
        "discriminator" : {
          "mapping" : {
            "message.created" : "#/components/schemas/MessageCreatedEvent",
            "presence.changed" : "#/components/schemas/PresenceChangedEvent"
          },
          "propertyName" : "type"
        },
        "oneOf" : [ {
          "$ref" : "#/components/schemas/MessageCreatedEvent"
        }, {
          "$ref" : "#/components/schemas/PresenceChangedEvent"
        } ]
      },
      "SendMessageRequest" : {
        "properties" : {
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "text" ],
        "type" : "object"
      },
      "SetAvatarRequest" : {
        "properties" : {
          "avatar" : {
            "$ref" : "#/components/schemas/PredefinedAvatar"
          }
        },
        "required" : [ "avatar" ],
        "type" : "object"
      },
      "UserDto" : {
        "properties" : {
          "avatar" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/PredefinedAvatar"
            }, {
              "type" : "null"
            } ]
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "avatar", "email", "id", "name" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "DA Bubble API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/conversations" : {
      "get" : {
        "operationId" : "listConversations",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/ConversationDto"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "conversations" ]
      }
    },
    "/api/conversations/{conversationId}/messages" : {
      "get" : {
        "operationId" : "listMessages",
        "parameters" : [ {
          "in" : "path",
          "name" : "conversationId",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePageDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "messages" ]
      },
      "post" : {
        "operationId" : "sendMessage",
        "parameters" : [ {
          "in" : "path",
          "name" : "conversationId",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SendMessageRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessageDto"
                }
              }
            },
            "description" : "Created"
          }
        },
        "tags" : [ "messages" ]
      }
    },
    "/api/conversations/{id}" : {
      "get" : {
        "operationId" : "getConversation",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConversationDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "conversations" ]
      }
    },
    "/api/me" : {
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "me" ]
      }
    },
    "/api/me/avatar" : {
      "put" : {
        "operationId" : "setAvatar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetAvatarRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "me" ]
      }
    },
    "/api/presence" : {
      "get" : {
        "operationId" : "listOnline",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "format" : "uuid",
                    "type" : "string"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "presence" ]
      }
    },
    "/api/users" : {
      "get" : {
        "operationId" : "listUsers",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/UserDto"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "users" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
