{
  "components" : {
    "schemas" : {
      "ConversationDto" : {
        "properties" : {
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "isDefault" : {
            "type" : "boolean"
          },
          "kind" : {
            "$ref" : "#/components/schemas/ConversationKind"
          },
          "name" : {
            "type" : [ "string", "null" ]
          },
          "partnerId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "id", "isDefault", "kind", "name", "partnerId" ],
        "type" : "object"
      },
      "ConversationKind" : {
        "enum" : [ "CHANNEL", "DIRECT_MESSAGE" ],
        "type" : "string"
      },
      "FieldErrorDto" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "field" ],
        "type" : "object"
      },
      "PredefinedAvatar" : {
        "enum" : [ "AVATAR_1", "AVATAR_2", "AVATAR_3", "AVATAR_4", "AVATAR_5", "AVATAR_6", "GUEST" ],
        "type" : "string"
      },
      "ProblemCode" : {
        "enum" : [ "BAD_REQUEST", "VALIDATION_FAILED", "UNAUTHENTICATED", "NOT_FOUND", "CONFLICT", "INTERNAL_ERROR" ],
        "type" : "string"
      },
      "ProblemDto" : {
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ProblemCode"
          },
          "detail" : {
            "type" : [ "string", "null" ]
          },
          "errors" : {
            "items" : {
              "$ref" : "#/components/schemas/FieldErrorDto"
            },
            "type" : "array"
          },
          "instance" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "detail", "errors", "instance", "status", "title", "type" ],
        "type" : "object"
      },
      "SetAvatarRequest" : {
        "properties" : {
          "avatar" : {
            "$ref" : "#/components/schemas/PredefinedAvatar"
          }
        },
        "required" : [ "avatar" ],
        "type" : "object"
      },
      "UserDto" : {
        "properties" : {
          "avatar" : {
            "oneOf" : [ {
              "$ref" : "#/components/schemas/PredefinedAvatar"
            }, {
              "type" : "null"
            } ]
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "avatar", "email", "id", "name" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "DA Bubble API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/conversations" : {
      "get" : {
        "operationId" : "listConversations",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/ConversationDto"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "conversations" ]
      }
    },
    "/api/conversations/{id}" : {
      "get" : {
        "operationId" : "getConversation",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConversationDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "conversations" ]
      }
    },
    "/api/me" : {
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "me" ]
      }
    },
    "/api/me/avatar" : {
      "put" : {
        "operationId" : "setAvatar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetAvatarRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "me" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
