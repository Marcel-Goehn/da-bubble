{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api": "orval",
    "prestart": "npm run generate:api",
    "start": "ng serve",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "npm run e2e:reset-stack && playwright test --project=e2e",
    "e2e:reset-stack": "docker compose -f ../compose.yaml down -v && docker compose -f ../compose.yaml up -d --wait",
    "lighthouse": "docker compose -f ../compose.yaml up -d --wait && playwright test --project=lighthouse",
    "typecheck:e2e": "tsc -p e2e",
    "lint": "ng lint --max-warnings 0",
    "lint:i18n": "transloco-keys-manager find --input src/app --translations-path src/i18n --langs de en --emit-error-on-extra-keys",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:keycloak-theme": "node scripts/build-keycloak-theme.mjs",
    "check:keycloak-theme": "node scripts/build-keycloak-theme.mjs --check",
    "check": "npm run lint && npm run typecheck:e2e && npm run lint:i18n && npm run format:check && npm run check:keycloak-theme && npm run test -- --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-locale": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "keycloak-angular": "^22.0.0",
    "keycloak-js": "^26.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-keys-manager": "^8.1.1",
    "@material-symbols/svg-400": "^0.48.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.5.0",
    "orval": "^8.44.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
