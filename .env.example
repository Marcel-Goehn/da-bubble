# Copy to .env to override the dev defaults. Every key is optional: a fresh clone runs without .env.
# Read by docker compose, by the backend in host mode (./gradlew bootRun) and by the E2E tests.

# Postgres password of the app's `dabubble` user (compose and backend).
POSTGRES_PASSWORD=dabubble
# Postgres password of Keycloak's `keycloak` user. Only read when the volume is first created.
KEYCLOAK_DB_PASSWORD=keycloak

# Keycloak admin console login at http://localhost:8080/admin. Only read when the database is first created.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Secret of the confidential `da-bubble-backend` service-account client (realm import).
KEYCLOAK_BACKEND_CLIENT_SECRET=dev-backend-secret

# Where the Angular app runs: the app client's base URL and redirect URIs (realm import), and the
# Keycloak theme's Impressum and Datenschutz links.
APP_BASE_URL=http://localhost:4200

# SeaweedFS S3 credentials (compose and backend).
S3_ACCESS_KEY=dabubble
S3_SECRET_KEY=dabubble-dev-secret
